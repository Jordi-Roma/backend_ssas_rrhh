APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=change-this-development-secret
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
APP_AUDIT_ENCRYPTION_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ssas_rrhh_dev
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000

# Backups privados en Supabase Storage. Nunca usar la anon key aquí.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
BACKUP_STORAGE_BUCKET=respaldos
BACKUP_RESTORE_ENABLED=false
BACKUP_RESTORE_CONFIRMATION=RESTAURAR BASE DE DATOS
BACKUP_FILES_DIRECTORY=uploads/cv
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Backups por empresa en Cloudflare R2 (separados del backup global anterior).
# Cargar las credenciales reales solo como variables privadas del backend en Railway.
R2_BACKUP_BUCKET=rrhh-backups
R2_S3_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
TENANT_BACKUP_RETENTION_DAYS=30
TENANT_BACKUP_ENABLED=false

# Stripe Sandbox. Las claves privadas solo pertenecen al backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/suscripcion/resultado?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/suscripcion
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/suscripcion
SUBSCRIPTION_GRACE_DAYS=3

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SSAS RRHH
SMTP_USE_TLS=true

# CV analysis: backend-only secret, never configure it in the frontend
OPENAI_API_KEY=
# Report interpretation only; keep this key on the backend.
GEMINI_API_KEY=
GEMINI_REPORT_MODEL=gemini-3.5-flash-lite
HELP_AI_ENABLED=false
HELP_AI_TIMEOUT_SECONDS=10
IA_MODEL=gpt-4o-mini
IA_TIMEOUT_SECONDS=60
IA_MAX_CV_BYTES=5242880
IA_MAX_CV_TEXT_CHARS=60000
IA_EXTRACTION_TIMEOUT_SECONDS=15
IA_MAX_OUTPUT_TOKENS=4000
IA_MAX_CONCURRENT_ANALYSES=2
CV_STORAGE_DIRECTORY=uploads/cv
